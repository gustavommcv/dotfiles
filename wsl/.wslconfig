# Goes in %USERPROFILE%\.wslconfig on the WINDOWS side (not inside any WSL distro, and not
# symlinked by install.sh since it lives outside the Linux filesystem entirely). Copy manually:
#
#   copy wsl\.wslconfig %USERPROFILE%\.wslconfig     (from PowerShell, run inside this repo)
#
# This file is global to ALL WSL2 distros on the machine, not just Arch. It's entirely
# optional — WSL2 already defaults to sane limits (up to 50% of host RAM, all logical
# processors) if the file is absent. Everything below is commented out on purpose; only
# uncomment values you've actually decided on for your own hardware.
#
# Reference: https://learn.microsoft.com/windows/wsl/wsl-config

[wsl2]
# memory=8GB
# processors=4
# swap=2GB

# GPU acceleration through WSLg (Vulkan/OpenGL passthrough to the host GPU via the Dozen
# driver, see wsl/../install.sh's mesa/vulkan-dzn packages) is on by default on current
# WSL versions — uncomment only if it needs to be forced back on.
# gpuSupport=true
